# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Python
__pycache__/
*.pyc
.Python

# Local environment / secrets
.env
.env.*

# Raw PDFs (large, may be copyrighted; place files here locally)
/data/raw_pdfs/*
!/data/raw_pdfs/.gitkeep

# Parsed outputs (regenerate via src/parse_pdf_pages.py or src/parse_pdf_mineru.py)
/data/parsed/*
!/data/parsed/.gitkeep

# Vector store (regenerate via src/embed_chunks.py)
/data/vector/*
!/data/vector/.gitkeep

# RAG 审计库（本地 SQLite，默认 data/audit/rag_audit.db）
/data/audit/*
!/data/audit/.gitkeep
