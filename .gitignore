# Python
__pycache__/
*.pyc
.Python

# Local environment / secrets
.env
.env.*

# Raw PDFs (large, may be copyrighted; place files here locally)
/data/raw_pdfs/*
!/data/raw_pdfs/.gitkeep

# Parsed outputs (regenerate via src/parse_pdf_pages.py or src/parse_pdf_mineru.py)
/data/parsed/*
!/data/parsed/.gitkeep

# Vector store (regenerate via src/embed_chunks.py)
/data/vector/*
!/data/vector/.gitkeep
