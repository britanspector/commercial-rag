            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "2025 年报及 2026 一季报点评：26Q1 业绩落于预告上沿，品牌孵化高增驱动增长"
                    }
                ],
                "level": 1
            },
            "bbox": [
                65,
                76,
                653,
                130
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "增持（维持）"
                    }
                ]
            },
            "bbox": [
                67,
                136,
                223,
                160
            ]
        },
        {
            "type": "table",
            "content": {
                "image_source": {
                    "path": "images/9e9a1e199cd5a7c8824176f78deac7cebda191c4dd36b38f32b7ed24bc43672f.jpg"
                },
                "table_caption": [],
                "table_footnote": [],
                "html": "<table><tr><td>盈利预测与估值</td><td>2024A</td><td>2025A</td><td>2026E</td><td>2027E</td><td>2028E</td></tr><tr><td>营业总收入（百万元）</td><td>1,153</td><td>1,415</td><td>1,770</td><td>2,171</td><td>2,630</td></tr><tr><td>同比（%）</td><td>19.20</td><td>22.69</td><td>25.11</td><td>22.65</td><td>21.16</td></tr><tr><td>归母净利润（百万元）</td><td>90.54</td><td>123.04</td><td>196.63</td><td>264.01</td><td>353.28</td></tr><tr><td>同比（%）</td><td>73.84</td><td>35.90</td><td>59.81</td><td>34.27</td><td>33.81</td></tr><tr><td>EPS-最新摊薄（元/股）</td><td>0.98</td><td>1.33</td><td>2.12</td><td>2.85</td><td>3.82</td></tr><tr><td>P/E（现价&amp;最新摊薄）</td><td>70.03</td><td>51.53</td><td>32.25</td><td>24.02</td><td>17.95</td></tr></table>",
                "table_type": "simple_table",
